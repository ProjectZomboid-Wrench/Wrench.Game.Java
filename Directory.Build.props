<Project>

    <PropertyGroup>
        <WrenchPackages Condition="'$(WrenchPackages)' == ''">$(MSBuildThisFileDirectory)../packages/</WrenchPackages>
        <Version>0.1.1</Version>
        <Authors>LambdaSix</Authors>
        <RepositoryUrl>https://github.com/ProjectZomboid-Wrench/Wrench.Game.Java</RepositoryUrl>
        <PackageOutputPath>$(WrenchPackages)</PackageOutputPath>
        <RestoreAdditionalProjectSources>$(WrenchPackages)</RestoreAdditionalProjectSources>
        <WrenchApiVersion Condition="'$(WrenchApiVersion)' == ''">0.1.1</WrenchApiVersion>
    </PropertyGroup>

</Project>
