<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Zomboid.Java</RootNamespace>
        <!-- Generated wrappers mirror Java, where hiding inherited members is routine. -->
        <NoWarn>$(NoWarn);CS0108;CS0114</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wrench.Host" />
        <InternalsVisibleTo Include="Wrench.Game.Lua" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Wrench.Api" Version="$(WrenchApiVersion)" />
    </ItemGroup>

</Project>
